# Add in Render's Environment dashboard; NEVER commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json
PORT=10000
NODE_ENV=production

# Staged Gavhah account linking: same 32+ byte random server-side secret on BOTH Render services.
# Do not add real secrets to GitHub or browser bundles.
# GAVHAH_CONNECT_SHARED_SECRET=
# GAVHAH_PUBLIC_URL=https://gavhah.onrender.com
# For read-only central Yemot hotline status (never a provider API key):
# GAVHAH_API_BASE_URL=https://gavhah.onrender.com
# YEMOT_CENTRAL_SHARED_SECRET=SEPARATE_32_PLUS_BYTE_RANDOM_SHARED_STATUS_SECRET
# Only one central Yemot root is managed in Gavhah; Campaign Center does not buy numbers or store individual telephone API keys.
