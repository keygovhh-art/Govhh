# Use the exact Neon STAGING connection string, never commit credentials.
DATABASE_URL=postgresql://user:password@staging-host.invalid/neondb?sslmode=require
# Trusted login issuer and JWKS verified server-side; no browser service secrets.
# For Neon Managed Better Auth, CC_JWT_ISSUER is the ORIGIN of the Neon Auth base URL.
# Copy CC_JWKS_URL from Neon get_auth on the STAGING branch, not production.
CC_JWT_ISSUER=https://your-staging-neon-auth-host.example
# Set only when verified for your specific JWT issuer; otherwise leave empty.
CC_JWT_AUDIENCE=
CC_JWKS_URL=https://your-staging-neon-auth-host.example/neondb/auth/.well-known/jwks.json
CC_PUBLIC_ORIGIN=https://your-staging-frontend.example
PORT=3001
# Server will refuse to boot against a production Neon host until staging config is reviewed.
CC_EXPECTED_DB_HOST=exact-neon-staging-host
